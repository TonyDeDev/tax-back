DATABASE_URL=
# At least 32 characters (openssl rand -base64 32). Also encrypts the stored SnapTrade tokens.
BETTER_AUTH_SECRET=
# The app's public origin; http://localhost:3000 locally, the Vercel domain in production
BETTER_AUTH_URL=http://localhost:3000
# Google sign-in (see docs/setup.md). Set both or neither.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# SnapTrade Dashboard, then OAuth Apps (see docs/setup.md). Set both or neither.
SNAPTRADE_OAUTH_CLIENT_ID=
SNAPTRADE_OAUTH_CLIENT_SECRET=
# At least 32 characters (openssl rand -base64 32)
CRON_SECRET=
# Keep the reserved .invalid domain so no identity provider can verify the address
DEMO_USER_EMAIL=demo@taxback.invalid
